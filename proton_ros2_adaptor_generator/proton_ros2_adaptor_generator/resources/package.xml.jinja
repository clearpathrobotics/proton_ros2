<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- Auto-generated package.xml for {{ package_name }} -->
<!-- DO NOT EDIT - Generated by proton_ros2_adaptor_generator -->
<package format="3">
  <name>{{ package_name }}</name>
  <version>{{ version | default('0.0.1') }}</version>
  <description>Proton ROS 2 message adaptors for {{ project_name }}</description>
  <maintainer email="{{ maintainer_email }}">{{ maintainer_name }}</maintainer>
  <license>{{ license | default('Apache-2.0') }}</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>pluginlib</build_depend>
  <build_depend>proton_ros2_interfaces</build_depend>
  <build_depend>rclcpp</build_depend>
{% for dep in ros_msg_dependencies %}
  <build_depend>{{ dep }}</build_depend>
{% endfor %}

  <exec_depend>pluginlib</exec_depend>
  <exec_depend>proton_ros2_interfaces</exec_depend>
  <exec_depend>rclcpp</exec_depend>
{% for dep in ros_msg_dependencies %}
  <exec_depend>{{ dep }}</exec_depend>
{% endfor %}

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
