{# Shared Jinja2 macros for proton_ros2 adaptor generation #}

{# C++ type mapping from proton signal types #}
{% set CPP_TYPE = {
  'double': 'double',
  'float': 'float',
  'int32': 'int32_t',
  'int64': 'int64_t',
  'uint32': 'uint32_t',
  'uint64': 'uint64_t',
  'bool': 'bool',
  'string': 'std::string',
  'bytes': 'std::vector<uint8_t>'
} %}

{#
  Generate code to read from proton registry and write to ROS message field.

  Parameters:
    m - Mapping object with:
      - signal_id: proton signal ID
      - ros_path: dot-separated path in ROS message (e.g., "header.frame_id"); a component
        may carry array indexes (e.g., "lights[0].red")
      - ros_index: (optional) array index for the last path component
      - proton_index: (optional) byte of a bytes signal that holds the field
      - data_type: proton type name (double, float, int32, etc.)
#}
{% macro to_ros(m) %}
{% set value = 'tmp[' ~ m.proton_index ~ ']' if m.proton_index is not none else 'tmp' %}
{
{# Create temporary type value #}
  {{ CPP_TYPE[m.data_type] }} tmp;
{% if m.data_type in ['string', 'bytes'] %}
  {# Capacity types need to be sized correctly #}
  tmp.resize({{ m.signal_capacity }});
{% endif %}
  proton::Signal<{{ CPP_TYPE[m.data_type] }}> sig(registry, {{ m.signal_id }});
  if (sig.get(tmp) == PROTON_OK) {
{% if m.nested_access %}
{# Member of an array element, or several array levels #}
    {{ m.write_expr }} = {{ value }};
{% elif m.ros_index is not none %}
  {# Indexed array access #}
    proton_ros2_interfaces::set_indexed_field<{{ m.ros_index }}>(msg.{{ m.ros_path }}, {{ value }});
{% else %}
    msg.{{ m.ros_path }} = {{ value }};
{% endif %}
  }
}
{% endmacro %}

{#
  Generate code to read from ROS message field and write to proton registry.

  Parameters:
    m - Mapping object (same as to_ros)
#}

{% macro to_proton(m) %}
{
  proton::Signal<{{ CPP_TYPE[m.data_type] }}> sig(generated_node.registry(), {{ m.signal_id }});
{% if m.proton_index is not none %}
{# Replace one byte of the signal and keep the others #}
  std::vector<uint8_t> val({{ m.signal_capacity }});
  if (sig.get(val) == PROTON_OK) {
    val[{{ m.proton_index }}] = static_cast<uint8_t>(
      {{ m.read_expr }});
    sig.set(val);
  }
{% else %}
{% if m.nested_access %}
{# Member of an array element, or several array levels #}
{% if m.data_type in ['string', 'bytes'] %}
  {{ CPP_TYPE[m.data_type] }} val = {{ m.read_expr }};
{% else %}
  {{ CPP_TYPE[m.data_type] }} val = static_cast<{{ CPP_TYPE[m.data_type] }}>(
    {{ m.read_expr }});
{% endif %}
{% elif m.ros_index is not none %}
{# Indexed array access #}
{% if m.data_type in ['string', 'bytes'] %}
{# Capacity types cannot be statically cast. But this will be caught via static_assert #}
  {{ CPP_TYPE[m.data_type] }} val = proton_ros2_interfaces::indexed_field<{{ m.ros_index }}>(msg.{{ m.ros_path }});
{% else %}
  {{ CPP_TYPE[m.data_type] }} val = static_cast<{{ CPP_TYPE[m.data_type] }}>(
    proton_ros2_interfaces::indexed_field<{{ m.ros_index }}>(msg.{{ m.ros_path }}));
{% endif %}
{% else %}
{# Scalar access #}
{% if m.data_type in ['string', 'bytes'] %}
  {{ CPP_TYPE[m.data_type] }} val = msg.{{ m.ros_path }};
{% else %}
  {{ CPP_TYPE[m.data_type] }} val = static_cast<{{ CPP_TYPE[m.data_type] }}>(msg.{{ m.ros_path }});
{% endif %}
{% endif %}

  sig.set(val);
{% endif %}
}
{% endmacro %}

{#
  Generate timestamp injection code for messages with stamp field.

  Parameters:
    stamp_path - dot-separated path to builtin_interfaces/Time field (e.g., "header.stamp")
#}
{% macro inject_timestamp(stamp_path) %}
msg.{{ stamp_path }} = node->get_clock()->now();
{% endmacro %}
